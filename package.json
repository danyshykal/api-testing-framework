{
  "name": "api-testing-framework",
  "version": "1.0.0",
  "description": "REST API test suite for Restful Booker using Postman and Newman",
  "scripts": {
    "test": "newman run collections/restful-booker.postman_collection.json -e environments/restful-booker.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/report.html"
  },
  "devDependencies": {
    "newman": "6.2.3",
    "newman-reporter-htmlextra": "1.23.1"
  }
}
