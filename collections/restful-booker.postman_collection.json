                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response matches booking schema\", () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"bookingSchema\")));",
                  "});",
                  "",
                  "pm.test(\"Returns the booking that was created\", () => {",
                  "    pm.expect(json.firstname).to.eql(pm.collectionVariables.get(\"firstname\"));",
                  "    pm.expect(json.lastname).to.eql(pm.collectionVariables.get(\"lastname\"));",
                  "});"
