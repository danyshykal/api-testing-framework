    {
      "name": "01 Auth",
      "description": "",
      "item": [
        {
          "name": "TC_API_02 Create token - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response contains a non-empty token\", () => {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "// Save the token so later requests (PUT, PATCH, DELETE) can use it",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC_API_03 Create token - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "// KNOWN ISSUE (BUG-001): API returns 200 OK for bad credentials.",
                  "// A correct API would return 401 Unauthorized.",
                  "pm.test(\"Status code is 200 (known issue: should be 401)\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Reason is 'Bad credentials'\", () => {",
                  "    pm.expect(json.reason).to.eql(\"Bad credentials\");",
                  "});",
                  "",
                  "pm.test(\"No token is returned\", () => {",
                  "    pm.expect(json).to.not.have.property(\"token\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 Booking CRUD",
      "description": "",
      "item": [
        {
          "name": "TC_API_04 Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh random test data on every run, so runs don't clash",
                  "pm.collectionVariables.set(\"firstname\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));",
                  "pm.collectionVariables.set(\"lastname\", pm.variables.replaceIn(\"{{$randomLastName}}\"));",
                  "pm.collectionVariables.set(\"totalprice\", _.random(50, 500));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const bookingSchema = JSON.parse(pm.collectionVariables.get(\"bookingSchema\"));",
                  "",
                  "pm.test(\"Response matches schema\", () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\",",
                  "        required: [\"bookingid\", \"booking\"],",
                  "        properties: {",
                  "            bookingid: { type: \"integer\" },",
                  "            booking: bookingSchema",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Saved data matches what was sent\", () => {",
                  "    pm.expect(json.booking.firstname).to.eql(pm.collectionVariables.get(\"firstname\"));",
                  "    pm.expect(json.booking.lastname).to.eql(pm.collectionVariables.get(\"lastname\"));",
                  "    pm.expect(json.booking.totalprice).to.eql(Number(pm.collectionVariables.get(\"totalprice\")));",
                  "    pm.expect(json.booking.bookingdates.checkin).to.eql(\"2026-12-01\");",
                  "});",
                  "",
                  "// Save the new ID so the next requests work on this booking",
                  "pm.collectionVariables.set(\"bookingId\", json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC_API_05 Get booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
